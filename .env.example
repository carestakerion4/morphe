# Скопируй в .env (файл .env в git не попадает) и подставь свои значения.

# --- Клиентский бандл (Vite) ---
# Переменные с префиксом VITE_ ВШИВАЮТСЯ в публичный JavaScript — их видит каждый посетитель.
# Поэтому сюда можно класть ТОЛЬКО публичный (anon / publishable) ключ.
# Ключ service_role / secret key сюда НЕЛЬЗЯ ни при каких обстоятельствах.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# --- Только для edge-обработчика превью ссылок (см. edge/README.md) ---
# Задаются в настройках хостинга, не в клиентском коде. Те же значения, без VITE_.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
